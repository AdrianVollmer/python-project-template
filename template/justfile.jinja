set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

# Install/sync dependencies
sync:
    uv sync

# Format code
fmt:
    uv run ruff format .
{%- if with_web_frontend %}
    uv run deno fmt --config frontend/deno.json frontend
{%- endif %}

# Check formatting without modifying files
fmt-check:
    uv run ruff format --check .
{%- if with_web_frontend %}
    uv run deno fmt --config frontend/deno.json --check frontend
{%- endif %}

# Lint with ruff{% if with_web_frontend %} and deno{% endif %} (pass --fix to auto-fix; used by the pre-commit hook)
lint *args:
    uv run ruff check {{ '{{' }}args{{ '}}' }} .
{%- if with_web_frontend %}
    uv run deno lint --config frontend/deno.json {{ '{{' }}args{{ '}}' }} frontend
{%- endif %}

# Type-check with ty{% if with_web_frontend %} and deno{% endif %}
typecheck:
    uv run ty check
{%- if with_web_frontend %}
    uv run deno check --config frontend/deno.json frontend/*.ts
{%- endif %}

# Lint, type-check, and verify formatting (no modifications)
check: lint typecheck fmt-check

# Install git hooks so checks run automatically on commit
hooks-install:
    uv run prek install

# Tag the next version (major/minor/patch, default patch), e.g. `just bump minor`
# Version comes from the latest vX.Y.Z git tag (uv-dynamic-versioning); push the tag yourself
bump level="patch":
    #!/usr/bin/env bash
    set -euo pipefail
    latest="$(git tag --list 'v*' --sort=-v:refname | head -n1)"
    IFS=. read -r major minor patch <<< "${latest#v}"
    case "{{ '{{' }}level{{ '}}' }}" in
        major) major=$((major + 1)); minor=0; patch=0 ;;
        minor) minor=$((minor + 1)); patch=0 ;;
        patch) patch=$((patch + 1)) ;;
        *) echo "Unknown level: {{ '{{' }}level{{ '}}' }}" >&2; exit 1 ;;
    esac
    new="v${major}.${minor}.${patch}"
    git tag -a "$new" -m "$new"
    echo "Tagged $new"
    # uv's build cache is keyed by source mtimes, not by git tag, so a bump on an
    # otherwise-unchanged tree needs a touch to be picked up; drop stale dist artifacts too
    touch pyproject.toml
    rm -rf dist
    uv sync

# Run tests
test:
    uv run pytest
{%- if with_web_frontend %}
    uv run deno test --config frontend/deno.json frontend
{%- endif %}

# Serve docs locally with live reload
docs:
    uv run zensical serve

# Build static docs site
docs-build:
    uv run zensical build

{% if with_web_frontend -%}
# Bundle the frontend into src/{{ package_name }}/static (included in the wheel)
frontend-build:
    uv run deno bundle --config frontend/deno.json --minify frontend/main.ts -o src/{{ package_name }}/static/main.js

# Build the sdist and wheel, including the bundled frontend
build: frontend-build
    uv build

{% else -%}
# Build the sdist and wheel
build:
    uv build

{% endif -%}
{% if is_app -%}
# Run the app{% if with_web_frontend %} (builds the frontend first){% endif %}, e.g. `just run hello`
run *args:{% if with_web_frontend %} frontend-build{% endif %}
    uv run {{ package_name.replace('_', '-') }} {{ '{{' }}args{{ '}}' }}

{% endif -%}
# Full check: what CI runs
ci: sync check test docs-build build
