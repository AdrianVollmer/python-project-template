[project]
name = "{{ package_name.replace('_', '-') }}"
version = "0.1.0"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">=3.12"
license = { text = "MIT" }
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" },
]
dependencies = [
{%- if is_app %}
    "click>=8.1",
{%- endif %}
]
{% if is_app %}
[project.scripts]
{{ package_name.replace('_', '-') }} = "{{ package_name }}.__main__:main"
{% endif %}
[dependency-groups]
dev = [
{%- if with_web_frontend %}
    "deno>=2.4",
{%- endif %}
    "prek>=0.5",
    "pytest>=8.0",
    "ruff>=0.16",
    "ty>=0.0.1a0",
    "zensical>=0.0.62",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

{% if with_web_frontend %}[tool.hatch.build]
# The bundled frontend is gitignored, so hatch must be told to include it in sdist and wheel
artifacts = ["src/{{ package_name }}/static"]

{% endif %}[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.ruff]
line-length = 120
target-version = "py312"

[tool.ruff.lint]
select = [
    "A",    # flake8-builtins
    "ARG",  # flake8-unused-arguments
    "B",    # flake8-bugbear
    "C4",   # flake8-comprehensions
    "D",    # pydocstyle
    "E",    # pycodestyle
    "ERA",  # eradicate (commented-out code)
    "F",    # pyflakes
    "FURB", # refurb
    "G",    # flake8-logging-format
    "I",    # isort
    "LOG",  # flake8-logging
    "N",    # pep8-naming
    "PLC",  # pylint
    "PTH",  # flake8-use-pathlib
    "RUF",  # ruff-specific rules
    "S",    # flake8-bandit
    "SIM",  # flake8-simplify
    "T20",  # flake8-print
    "TID",  # flake8-tidy-imports
    "TRY",  # tryceratops
    "UP",   # pyupgrade
]

[tool.ruff.lint.per-file-ignores]
"tests/*" = ["ARG", "D", "S101"]
{% if is_app %}
"src/{{ package_name }}/cli.py" = ["PLC0415"]
{% endif %}

[tool.ruff.format]
quote-style = "double"

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ty.environment]
python-version = "3.12"
